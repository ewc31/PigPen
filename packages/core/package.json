{
  "name": "@pigpen/core",
  "version": "0.1.0",
  "description": "PigPen core: .pigpen file format, handoff safety and the preflight engine.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
