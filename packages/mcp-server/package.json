{
  "name": "@pigpen/mcp-server",
  "version": "0.1.0",
  "description": "PigPen MCP server: preflight, brief and handoff tools for Claude Code, Cursor and any MCP client.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "pigpen-mcp": "./dist/index.js"
  },
  "exports": {
    ".": {
      "source": "./src/server.ts",
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@pigpen/core": "workspace:*",
    "zod": "^4.0.0"
  }
}
